    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output || '';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nconst username = $('Telegram Trigger').first().json.message.from.username || 'без нікнейму';\n\nconst leadMatch = aiOutput.match(/\\[LEAD:\\s*(.*?)\\s*\\|\\s*(.*?)\\s*\\|\\s*(.*?)\\]/);\nconst cleanReply = aiOutput.replace(/\\[LEAD:.*?\\]/g, '').trim();\n\nreturn [{\n  json: {\n    chatId,\n    replyText: cleanReply,\n    hasLead: Boolean(leadMatch),\n    clientName: leadMatch ? leadMatch[1] : '',\n    clientPhone: leadMatch ? leadMatch[2] : '',\n    service: leadMatch ? leadMatch[3] : '',\n    username: '@' + username,\n    date: new Date().toLocaleString('uk-UA', { timeZone: 'Europe/Kyiv' })\n  }\n}];\n"
      },
